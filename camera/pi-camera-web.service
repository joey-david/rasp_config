[Unit]
Description=Modern OV5647 Raspberry Pi Camera Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joey
Group=joey
WorkingDirectory=/home/joey/camera
Environment=CAMERA_RECORD_DIR=/home/joey/camera-recordings
Environment=CAMERA_WIDTH=1296
Environment=CAMERA_HEIGHT=972
Environment=CAMERA_FPS=15
ExecStart=/usr/bin/python3 /home/joey/camera/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
