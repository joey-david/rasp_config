[Unit]
Description=Mischief Bot Web Interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joey
Group=joey
WorkingDirectory=/home/joey
Environment=CAMERA_WIDTH=1296
Environment=CAMERA_HEIGHT=972
Environment=CAMERA_FPS=30
Environment=MOTOR_POWER=50
Environment=MOTOR_PWM_FREQ=1000
ExecStart=/usr/bin/python3 /home/joey/web_interface.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
