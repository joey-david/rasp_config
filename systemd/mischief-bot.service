[Unit]
Description=Mischief Bot Web Interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joey
Group=joey
WorkingDirectory=/home/joey
Environment=CAMERA_WIDTH=1296
Environment=CAMERA_HEIGHT=972
Environment=CAMERA_FPS=15
Environment=MOTOR_POWER=70
Environment=MOTOR_PWM_FREQ=1000
Environment=MOTOR_RAMP_SECONDS=0.05
Environment=TRACKER_HZ=10
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/joey/web_interface.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
