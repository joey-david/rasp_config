[Unit]
Description=Mischief Bot Web Interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joey
Group=joey
WorkingDirectory=/home/joey
Environment=CAMERA_WIDTH=640
Environment=CAMERA_HEIGHT=480
Environment=CAMERA_FPS=30
Environment=MOTION_UDP_PORT=8766
Environment=MOTOR_POWER=70
Environment=MOTOR_PWM_FREQ=1000
Environment=MOTOR_RAMP_SECONDS=0.05
Environment=TRACKER_HZ=30
Environment=TRACKER_WIDTH=160
Environment=TRACKER_HEIGHT=120
Environment=TRACKER_LABELS=person
Environment=TRACKER_SEARCH_PAD=0.12
Environment=TRACKER_MIN_SCORE=0.25
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/joey/web_interface.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
