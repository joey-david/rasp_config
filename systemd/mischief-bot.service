[Unit]
Description=Mischief Bot Web Interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joey
Group=joey
WorkingDirectory=/home/joey
Environment=CAMERA_WIDTH=640
Environment=CAMERA_HEIGHT=480
Environment=CAMERA_FPS=30
Environment=MOTION_UDP_PORT=8766
Environment=MOTOR_POWER=70
Environment=MOTOR_PWM_FREQ=1000
Environment=MOTOR_RAMP_SECONDS=0.05
Environment=PC_DETECT_URL=http://192.168.0.24:8081/detect
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/joey/web/web_interface.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
